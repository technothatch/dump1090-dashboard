  "keywords": [
    "ads-b",
    "dump1090",
    "readsb",
    "mode-s",
    "aircraft",
    "adsb",
    "dashboard",
    "vite",
    "typescript"
  ],
  "license": "MIT",
  "author": "technothatch",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/technothatch/dump1090-dashboard.git"
  },
  "homepage": "https://github.com/technothatch/dump1090-dashboard#readme",
  "bugs": {
    "url": "https://github.com/technothatch/dump1090-dashboard/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
